<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <!-- WPF framework reference is only needed for the managed UI Automation client (UIAutomationClient). -->
    <UseWPF>true</UseWPF>
    <RootNamespace>Kuroko.Platform</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Kuroko.Core\Kuroko.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Lets the tests build fake UIA answers and shorten timeouts; nothing else depends on it. -->
    <InternalsVisibleTo Include="Kuroko.Windows.Tests" />
  </ItemGroup>

</Project>
