<Window x:Class="Kuroko.App.Keys.ApiKeysWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="440" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource Font.Family}" FontSize="13" UseLayoutRounding="True">
    <StackPanel Margin="18">
        <TextBlock x:Name="Intro" TextWrapping="Wrap" Margin="0,0,0,14"/>

        <TextBlock x:Name="ProviderLabel" Margin="0,0,0,4"/>
        <ComboBox x:Name="Providers" SelectionChanged="OnProviderChanged"/>
        <TextBlock x:Name="Source" TextWrapping="Wrap" Margin="0,6,0,14" Opacity="0.75"/>

        <TextBlock x:Name="KeyLabel" Margin="0,0,0,4"/>
        <PasswordBox x:Name="Key" Padding="4,3"/>

        <TextBlock x:Name="Feedback" TextWrapping="Wrap" Margin="0,10,0,0" Visibility="Collapsed"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="SaveButton" IsDefault="True" MinWidth="88" Padding="10,3" Click="OnSave"/>
            <Button x:Name="RemoveButton" MinWidth="88" Padding="10,3" Margin="8,0,0,0" Click="OnRemove"/>
            <Button x:Name="CloseButton" IsCancel="True" MinWidth="88" Padding="10,3" Margin="8,0,0,0"/>
        </StackPanel>
    </StackPanel>
</Window>
